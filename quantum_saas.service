[Unit]
Description=Quantum SaaS Flask app
After=network.target
[Service]
User=root
WorkingDirectory=/var/www/quantum_saas
Environment="PATH=/var/www/quantum_saas/.venv/bin"
ExecStart=/var/www/quantum_saas/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 quantum_saas_app:app
Restart=always
[Install]
WantedBy=multi-user.target
