[Unit]
Description=Quantum Aether exposure registry: weekly anchor (upgrade) via OpenTimestamps
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quantum
Group=quantum
WorkingDirectory=/var/www/quantum_saas
EnvironmentFile=/etc/quantum_saas.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/quantum_saas
ExecStart=/var/www/quantum_saas/.venv312/bin/python3 exposure_job.py upgrade
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quantum_saas
