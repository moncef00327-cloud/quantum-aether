[Unit]
Description=Quantum Aether daily monitoring scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quantum
Group=quantum
WorkingDirectory=/var/www/quantum_saas
EnvironmentFile=/etc/quantum_saas.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/www/quantum_saas/.venv/bin/python3 monitor_job.py
TimeoutStartSec=3h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quantum_saas
