[Unit]
Description=Quantum Aether daily discovery: retry weekly IndexNow, scan new watch-list domains, send new or changed URLs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quantum
Group=quantum
WorkingDirectory=/var/www/quantum_saas
EnvironmentFile=/etc/quantum_saas.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/www/quantum_saas/.venv312/bin/python3 adoption_job.py indexnow
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quantum_saas
