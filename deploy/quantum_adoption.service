[Unit]
Description=Quantum Aether weekly post-quantum adoption scan (/adoption)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=quantum
Group=quantum
WorkingDirectory=/var/www/quantum_saas
EnvironmentFile=/etc/quantum_saas.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/var/www/quantum_saas/.venv/bin/python3 adoption_job.py
TimeoutStartSec=3h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/quantum_saas
